# ZeroClaw Configuration Template (schema v3 — zeroclaw 0.8.0+)
# Copy to ~/.zeroclaw/config.toml or let install.sh place it there.
#
# Recommended: run onboarding instead of hand-editing this file:
#   sudo -u zeroclaw zeroclaw onboard
#
# Pre-0.8.0 keys (default_provider, api_key at the root, flat [channels.*])
# are no longer valid. If you upgraded from an older install, commit the
# in-memory migration to disk:
#   sudo -u zeroclaw zeroclaw config migrate

schema_version = 3

[gateway]
web_dist_dir = "/usr/share/zeroclaw/web/dist"
# host = "0.0.0.0"          # default is 127.0.0.1 (local only)
# port = 42617
# allow_public_bind = true   # required when host is 0.0.0.0 or [::]
#
# Pairing is enabled by default. From another device, open http://<server-ip>:42617
# and complete pairing, or run on the server:
#   sudo -u zeroclaw zeroclaw gateway paircode

